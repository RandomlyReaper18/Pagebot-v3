# Copy these into your hosting provider's environment settings (never commit real values).

# Meta app dashboard > Messenger API setup > Generate access tokens
PAGE_ACCESS_TOKEN=
# Any random string you choose; enter the same value when configuring the webhook in Meta
VERIFY_TOKEN=
# Meta app dashboard > App settings > Basic > App secret (used to verify webhook signatures)
APP_SECRET=
# Key for kaiz-apis.gleeze.com (used by ai, black, uid). Rotate the old one that was in the code.
KAIZ_API_KEY=
# Optional: only for the web chat page (/api/chat)
GEMINI_API_KEY=
